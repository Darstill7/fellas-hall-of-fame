  "definitions": {
    "closestDefeats": "Smallest absolute score margin in distinct decided regular-season head-to-head games.",
    "pointsScoredInLosses": "Sum of a manager's own points in regular-season losses; unadjusted for tenure/season length, not a standalone schedule-luck metric.",
    "secondHighestScoreLosses": "Losses in fully paired regular-season weeks when a manager beat every other team except the actual opponent. 2016 8 teams, later years 10.",
    "scheduleShortfall": "All-play expected wins minus observed win credits over complete paired regular-season weeks. Describes schedule draw, not causal proof of luck."
  },
  "notes": [
    "Raw ESPN and Sleeper scoring rules differ. 2026 is in progress.",
    "All-play analysis excludes 2020 and 2021 Week 14 because the full league was not paired.",
    "Cross-era raw career sums are descriptive; they systematically reward longer tenures and different scoring environments."
  ],

  "coverage": "Single-game regular-season data through 2026 Week 9; all-play fully paired weeks through 2026 Week 8; completed seasons through 2025",
  "methodology": {
    "lowestWinningScores": "Smallest winning team scores in decided regular-season head-to-head games; no cross-era normalization.",
    "secondLowestScoringWins": "Wins despite ranking second-lowest of full paired-league weekly scores. A true weekly lowest score cannot win a conventional head-to-head game against a league opponent with a strictly lower score.",
    "seasonScheduleSurplus": "Actual win credits (wins plus half ties) less expected wins against a uniformly randomly selected league opponent using same-week all-play scores, fully paired weeks only.",
    "careerSurplus": "Summed per-season fully-paired actual and expected win credits for completed seasons; normalize surplus by paired weeks to compare different tenures."
  },
  "cautions": [
    "Not a causal luck metric; measures opponent-draw advantage rather than player selection quality.",
    "2016 has eight teams; 2017 onward ten; all-play expectation adjusts for league size.",
    "2020 and 2021 unpaired Week 14 records are excluded from the all-play comparisons.",
    "2026 rankings provisional and excluded from completed-season and career totals.",
    "Rounding of source expected wins to three decimals may affect career totals by a few thousandths."
  ],
